# ── Rust ─────────────────────────────────────────────────────
/target/

# Cargo.lock is committed for this application workspace (reproducible builds).
# If this becomes a library published to crates.io, ignore it instead:
#   Cargo.lock

# ── OhMyOpenCode (omo) ───────────────────────────────────────
# Runtime state (session continuation, plans, boulder state) — machine-local.
.omo/
# CodeGraph index — a symlink to a machine-local cache. Never commit.
.codegraph

# ── Claude Code ──────────────────────────────────────────────
# NOTE: `.claude/summary/summary_and_next.md` IS a tracked deliverable
# (see AGENTS.md) — do not ignore `.claude/` wholesale. Only local settings.
.claude/settings.local.json

# ── VS Code ─────────────────────────────────────────────────
# Ignore everything except the shareable workspace files below.
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
# Remote-SSH / dev-container server state — machine-local.
.vscode-server/

# ── Zed ──────────────────────────────────────────────────────
# `.zed/settings.json` is shareable and stays tracked; only local overrides
# are ignored.
.zed/settings.local.json

