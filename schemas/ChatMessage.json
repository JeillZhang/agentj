{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChatMessage",
  "type": "object",
  "properties": {
    "content": {
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/Role"
    },
    "tool_call_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ToolCall"
      }
    }
  },
  "required": [
    "role",
    "content"
  ],
  "$defs": {
    "Role": {
      "type": "string",
      "enum": [
        "system",
        "user",
        "assistant",
        "tool"
      ]
    },
    "ToolCall": {
      "type": "object",
      "properties": {
        "arguments": true,
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "arguments"
      ]
    }
  }
}
