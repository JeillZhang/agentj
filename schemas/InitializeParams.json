{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InitializeParams",
  "description": "`initialize` request params (design 决策 #2).",
  "type": "object",
  "properties": {
    "capabilities": true,
    "client_info": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClientInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "protocol_version": {
      "type": "string"
    },
    "token": {
      "description": "Access token required by a token-gated resident kernel (--token).\nAbsent when the kernel runs without auth — additive.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "protocol_version"
  ],
  "$defs": {
    "ClientInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    }
  }
}
