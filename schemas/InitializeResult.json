{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InitializeResult",
  "type": "object",
  "properties": {
    "capabilities": true,
    "connection_id": {
      "description": "This connection's unique id in a multi-client kernel (design 决策 #6).\nAbsent in single-client (stdio) mode. Capability flag: capabilities.multi_client.",
      "type": [
        "string",
        "null"
      ]
    },
    "protocol_version": {
      "type": "string"
    },
    "server_info": {
      "$ref": "#/$defs/ServerInfo"
    }
  },
  "required": [
    "protocol_version",
    "server_info"
  ],
  "$defs": {
    "ServerInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    }
  }
}
