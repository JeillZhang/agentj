{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KernelStatusResult",
  "type": "object",
  "properties": {
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ModuleInfo"
      }
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "modules"
  ],
  "$defs": {
    "ModuleInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ModuleState"
        }
      },
      "required": [
        "id",
        "state"
      ]
    },
    "ModuleState": {
      "type": "string",
      "enum": [
        "unloaded",
        "initializing",
        "ready",
        "stopping",
        "stopped",
        "failed"
      ]
    }
  }
}
