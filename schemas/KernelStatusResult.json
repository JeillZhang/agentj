{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KernelStatusResult",
  "type": "object",
  "properties": {
    "default_model": {
      "description": "Config model.default_model, e.g. \"deepseek-chat\". Absent when no config. @since 0.12.0",
      "type": [
        "string",
        "null"
      ]
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ModuleInfo"
      }
    },
    "providers": {
      "description": "Provider list from config (name → base_url); models reserved, empty. @since 0.12.0",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/ProviderInfo"
      }
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "modules"
  ],
  "$defs": {
    "ModuleInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ModuleState"
        }
      },
      "required": [
        "id",
        "state"
      ]
    },
    "ModuleState": {
      "type": "string",
      "enum": [
        "unloaded",
        "initializing",
        "ready",
        "stopping",
        "stopped",
        "failed"
      ]
    },
    "ProviderInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "models"
      ]
    }
  }
}
