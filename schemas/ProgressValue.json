{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProgressValue",
  "description": "`$/progress` payload, discriminated by `kind` (design 决策 #3).\nAn unknown `kind` is ignorable by consumers (per `$/`-prefix convention,\ndesign 决策 #5) — consumer-side behavior documented in the spec, deferred to v0.1.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "delta": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "text"
        }
      },
      "required": [
        "kind",
        "delta"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "tool_call"
        },
        "tool_call": {
          "$ref": "#/$defs/ToolCall"
        }
      },
      "required": [
        "kind",
        "tool_call"
      ]
    },
    {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "tool_result"
        },
        "tool_call_id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "tool_call_id",
        "content"
      ]
    },
    {
      "description": "Token-usage settlement emitted once per run at Done (design D1 结算行). @since 0.12.0",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "usage"
        },
        "usage": {
          "$ref": "#/$defs/UsageInfo"
        }
      },
      "required": [
        "kind",
        "usage"
      ]
    },
    {
      "description": "Decision settlement for a pending $/permissionRequest (design D1 轨迹/卡片结算).\nsession_id is optional-additive so multi-session clients route the settle.",
      "type": "object",
      "properties": {
        "decision": {
          "$ref": "#/$defs/PermissionDecision"
        },
        "kind": {
          "type": "string",
          "const": "permission"
        },
        "request_id": {
          "type": "string"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "request_id",
        "tool",
        "decision"
      ]
    },
    {
      "description": "Full TODO snapshot (design 决策 #2); revision is monotonic per session,\nclients discard snapshots older than the highest seen. @since 0.13.0",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TodoItem"
          }
        },
        "kind": {
          "type": "string",
          "const": "todo"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "session_id",
        "revision",
        "items"
      ]
    },
    {
      "description": "Workspace file change produced by write/bash artifacts (design 决策 #3). @since 0.13.0",
      "type": "object",
      "properties": {
        "change": {
          "$ref": "#/$defs/FileChange"
        },
        "kind": {
          "type": "string",
          "const": "file_change"
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "session_id",
        "change"
      ]
    }
  ],
  "$defs": {
    "FileChange": {
      "description": "A workspace file change. @since 0.13.0",
      "type": "object",
      "properties": {
        "additions": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "diff": {
          "description": "Unified diff text; omitted when unavailable (untracked / over limit).",
          "type": [
            "string",
            "null"
          ]
        },
        "diff_truncated": {
          "description": "True only when the diff was truncated; omitted otherwise.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "op": {
          "$ref": "#/$defs/FileChangeKind"
        },
        "path": {
          "description": "Path relative to the project root.",
          "type": "string"
        },
        "tool_call_id": {
          "description": "Tool call card this change belongs to; omitted when unavailable.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "op",
        "additions",
        "deletions"
      ]
    },
    "FileChangeKind": {
      "description": "Change operation of a `FileChange`. `Unknown` tolerates forward values\n(serde(other)); schema lists only the known values. @since 0.13.0",
      "type": "string",
      "enum": [
        "add",
        "modify",
        "delete"
      ]
    },
    "PermissionDecision": {
      "description": "Decision value in `PermissionRespondParams`. `Unknown` tolerates forward\nvalues (serde(other)); schema lists only the known values.",
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "allow_always"
      ]
    },
    "TodoItem": {
      "description": "One entry of a full TODO snapshot. @since 0.13.0",
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "id": {
          "description": "Kernel-computed stable id (content hash; duplicates disambiguated by occurrence).",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TodoStatus"
        }
      },
      "required": [
        "id",
        "content",
        "status"
      ]
    },
    "TodoStatus": {
      "description": "Lifecycle status of a TODO item. `Unknown` tolerates forward values\n(serde(other)); schema lists only the known values. @since 0.13.0",
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "cancelled"
      ]
    },
    "ToolCall": {
      "type": "object",
      "properties": {
        "arguments": true,
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "arguments"
      ]
    },
    "UsageInfo": {
      "type": "object",
      "properties": {
        "completion_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "prompt_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "prompt_tokens",
        "completion_tokens"
      ]
    }
  }
}
