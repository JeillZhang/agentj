{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProgressValue",
  "description": "`$/progress` payload, discriminated by `kind` (design 决策 #3).\nAn unknown `kind` is ignorable by consumers (per `$/`-prefix convention,\ndesign 决策 #5) — consumer-side behavior documented in the spec, deferred to v0.1.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "delta": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "text"
        }
      },
      "required": [
        "kind",
        "delta"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "tool_call"
        },
        "tool_call": {
          "$ref": "#/$defs/ToolCall"
        }
      },
      "required": [
        "kind",
        "tool_call"
      ]
    },
    {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "tool_result"
        },
        "tool_call_id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "tool_call_id",
        "content"
      ]
    },
    {
      "description": "Token-usage settlement emitted once per run at Done (design D1 结算行). @since 0.12.0",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "usage"
        },
        "usage": {
          "$ref": "#/$defs/UsageInfo"
        }
      },
      "required": [
        "kind",
        "usage"
      ]
    },
    {
      "description": "Decision settlement for a pending $/permissionRequest (design D1 轨迹/卡片结算).\nsession_id is optional-additive so multi-session clients route the settle.",
      "type": "object",
      "properties": {
        "decision": {
          "$ref": "#/$defs/PermissionDecision"
        },
        "kind": {
          "type": "string",
          "const": "permission"
        },
        "request_id": {
          "type": "string"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "request_id",
        "tool",
        "decision"
      ]
    }
  ],
  "$defs": {
    "PermissionDecision": {
      "description": "Decision value in `PermissionRespondParams`. `Unknown` tolerates forward\nvalues (serde(other)); schema lists only the known values.",
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "allow_always"
      ]
    },
    "ToolCall": {
      "type": "object",
      "properties": {
        "arguments": true,
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "arguments"
      ]
    },
    "UsageInfo": {
      "type": "object",
      "properties": {
        "completion_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "prompt_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "prompt_tokens",
        "completion_tokens"
      ]
    }
  }
}
