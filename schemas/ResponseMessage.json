{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResponseMessage",
  "description": "A JSON-RPC 2.0 response: exactly one of `result` (success) or `error` (failure).",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "jsonrpc": {
          "type": "string"
        },
        "result": true
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorObject"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "jsonrpc": {
          "type": "string"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ]
    }
  ],
  "$defs": {
    "ErrorObject": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "data": true,
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "Id": {
      "description": "JSON-RPC 2.0 request/notification id. `Null` is used only in error responses\nwhere the request id could not be determined (e.g. parse error — JSON-RPC 2.0 §5).",
      "anyOf": [
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
