{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionRunParams",
  "type": "object",
  "properties": {
    "attachments": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Attachment"
      }
    },
    "content": {
      "type": "string"
    },
    "model": {
      "description": "Per-run model id override, e.g. \"opencode-go/kimi-k3\". Absent = config\nmodel.default_model. @since 0.16.0",
      "type": [
        "string",
        "null"
      ]
    },
    "progress_token": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProgressToken"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "description": "Per-run provider name override (registered provider name). Absent = default\nprovider. @since 0.16.0",
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "content"
  ],
  "$defs": {
    "Attachment": {
      "type": "object",
      "properties": {
        "content": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ProgressToken": {
      "description": "Streaming progress token — independent of the request id (design 决策 #3).",
      "anyOf": [
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "string"
        }
      ]
    }
  }
}
