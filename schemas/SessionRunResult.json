{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionRunResult",
  "type": "object",
  "properties": {
    "content": {
      "type": "string"
    },
    "run_id": {
      "description": "Run id that scopes this turn's todo/file_change events. @since 0.15.0",
      "type": [
        "string",
        "null"
      ]
    },
    "tool_calls": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/ToolCall"
      }
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/UsageInfo"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "content"
  ],
  "$defs": {
    "ToolCall": {
      "type": "object",
      "properties": {
        "arguments": true,
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "arguments"
      ]
    },
    "UsageInfo": {
      "type": "object",
      "properties": {
        "completion_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "prompt_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "prompt_tokens",
        "completion_tokens"
      ]
    }
  }
}
