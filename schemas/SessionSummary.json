{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionSummary",
  "description": "One row of `session/list`. @since 0.12.0",
  "type": "object",
  "properties": {
    "preview": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/SessionStatus"
    },
    "updated_at": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "session_id",
    "updated_at",
    "state"
  ],
  "$defs": {
    "SessionStatus": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "deleted"
      ]
    }
  }
}
